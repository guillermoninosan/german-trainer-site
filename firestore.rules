rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One progress document per signed-in Google account, named by that
    // account's uid. Only that account can read or write its own document -
    // nobody else's data is reachable, and an unauthenticated request is
    // refused outright.
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is denied by default (no other paths are used by the app).
  }
}
